{
  "name": "@haunt-kit/relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx src/node/main.ts",
    "dev:worker": "wrangler dev",
    "check:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@haunt-kit/protocol": "workspace:*",
    "ws": "^8.23.0"
  }
}
