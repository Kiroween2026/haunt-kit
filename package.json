{
  "name": "haunt-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --filter \"./apps/*\" --filter @haunt-kit/controller build",
    "dev:seance": "pnpm --filter @haunt-kit/seance-party dev",
    "dev:steady": "pnpm --filter @haunt-kit/steady dev",
    "dev:relay": "pnpm --filter @haunt-kit/relay dev",
    "dev:token": "tsx packages/relay/src/node/make-token.ts",
    "dev:controller": "pnpm --filter @haunt-kit/controller dev",
    "dev:demo": "pnpm --filter @haunt-kit/host-sdk demo",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@haunt-kit/host-sdk": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
